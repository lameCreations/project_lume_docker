services:
  lume-engine:
    image: lamecreations/project_lume:latest
    container_name: project-lume-core
    restart: unless-stopped
    ports:
      - "9000:9000"
      - "514:514/udp"
      - "514:514/tcp"
      - "1514:1514/udp"
      - "1514:1514/tcp"
    environment:
      - PORT=9000
      - PYTHONUNBUFFERED=1
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - lume_vaults:/app/data_vaults
      - ./Dropzone_Inputs:/app/dropzone
      - ./web_workspaces:/app/web/workspaces
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:9000/api/settings/health')"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

volumes:
  lume_vaults:
